# Thư mục build của CMake (kể cả build-asan, build-tsan)
build*/
out/
bin/

# Tệp thực thi và tệp biên dịch
*.exe
*.o
*.obj

# Tài liệu: chỉ bỏ các tệp PDF bài báo (xem lưu ý bản quyền)
docs/*.pdf

# Dữ liệu lớn: không commit, chỉ commit script sinh dữ liệu
data/raw/*
data/synthetic/*
!data/raw/.gitkeep
!data/synthetic/.gitkeep

# VS Code: bỏ cấu hình cá nhân, giữ danh sách tiện ích gợi ý
.vscode/*
!.vscode/extensions.json